# R artifacts (still used by pipelines/pre1961-matching/)
renv/library/
renv/staging/
renv/cellar/
renv/sandbox/
.Rhistory
.RData
.Rproj.user
*.Rproj

# Raw polygon source data — fetched by scripts/sources/<slug>/fetch.*,
# never committed. Each source has a fetch script that re-downloads from
# its original location.
data/geodata/**
!data/geodata/.gitkeep

# Compiled / temporary pipeline outputs
data/compiled/

# Large third-party datasets. data/external/ itself IS tracked -- it holds small committed
# reference tables like cow_state_system.csv -- but anything here is too big to version and is
# reproducible from its owner. Loaded via pipelines/polity-autoimprove/extdata.py, which takes an
# env override so the file can live outside the repo instead (as layer B does).
data/external/whep_crops/

# Wiki source PDFs (copyrighted; stored locally, not redistributed)
wiki/sources/pdfs/*.pdf
!wiki/sources/pdfs/README.md
wiki/.obsidian/

# Claude Code session state
.claude/

# Python bytecode
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Source datasets kept LOCAL ONLY (2026-08-19, at the maintainer's request).
#
# These are third-party / to-be-published-separately inputs, not products of
# this repository. They were tracked until now; untracked so they are not
# redistributed from here.
#
# NOTHING IN CI READS THEM. `scripts/crosscheck_matchers.py` mentions
# before_1961.csv only in a comment; its actual input is the committed
# `pipelines/pre1961-matching/state/r_crosswalk.csv`. The two scripts that do
# read these files -- pipelines/pre1961-matching/match.R (needs an R toolchain
# CI does not have) and pipelines/polity-autoimprove/prepare_federico_tena.py --
# are not invoked in the workflow. Regenerating either requires a local copy.
data/external/before_1961.csv
data/external/federico_tena_polities.xlsx
data/external/federico_tena/
